PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/bookleaf
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
CLIENT_ORIGIN=http://localhost:4200

# --- AI (server-side only; never exposed to the frontend) ---
# Set ONE key. Leave both empty to run in "rule-based fallback" mode.
# Free option: Google Gemini key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Optional: force a provider ("gemini" | "anthropic") and/or a model name.
AI_PROVIDER=
AI_MODEL=
AI_TIMEOUT_MS=15000
