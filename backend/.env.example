PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/bookleaf
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
CLIENT_ORIGIN=http://localhost:4200

# --- AI (server-side only; never exposed to the frontend) ---
# Leave ANTHROPIC_API_KEY empty to run in "rule-based fallback" mode.
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
AI_TIMEOUT_MS=15000
